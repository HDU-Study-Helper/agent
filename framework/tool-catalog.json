  {
    "name": "data_query",
    "description": "Query an authorized dataset using readonly structured filters, never raw SQL",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "fields": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "filters": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "field": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "operator": {
                "enum": [
                  "eq",
                  "ne",
                  "lt",
                  "lte",
                  "gt",
                  "gte",
                  "contains"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "field",
              "operator",
              "value"
            ],
            "type": "object"
          },
          "maxItems": 20,
          "type": "array"
        },
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "dataset",
        "fields"
      ],
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "rows": {
          "items": {
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "rows"
      ],
      "type": "object"
    },
    "permissions": [
      "data.read"
    ],
    "timeout": 20000000000
  },
