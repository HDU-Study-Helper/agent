{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trigger Agent decision · indices_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "reason",
    "relevant_indices"
  ],
  "properties": {
    "decision": {
      "enum": [
        "TRIGGER",
        "IGNORE",
        "UNCERTAIN"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "relevant_indices": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "IGNORE"
          }
        }
      },
      "then": {
        "properties": {
          "relevant_indices": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
