{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trigger Agent page input · indices_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selection_protocol",
    "changes"
  ],
  "properties": {
    "selection_protocol": {
      "const": "indices_v1"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "connection_id"],
      "properties": {
        "kind": {"enum": ["course", "unassociated", "group"]},
        "connection_id": {"type": "string", "minLength": 1},
        "offering_id": {"type": "string"},
        "course_ref": {"type": "string"},
        "course_name": {"type": "string"},
        "group_id": {"type": "string"}
      }
    },
    "course": {
      "type": "object",
      "description": "可选课程业务上下文；不要求历史 fixture 补充课程元数据。"
    },
    "refresh_id": {"type": "string"},
    "processing_unit": {
      "enum": ["course", "unassociated_connection", "dws_group"]
    },
    "time_semantics": {"type": "string"},
    "validation_error": {"type": "string"},
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "count", "change_offset", "total_changes"],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "count": {"type": "integer", "minimum": 1},
        "change_offset": {"type": "integer", "minimum": 0},
        "total_changes": {"type": "integer", "minimum": 0}
      }
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "changes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "operation",
          "resource"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "当前页 changes 的 1-based 连续编号；连续性由接入层按数组位置检查。"
          },
          "operation": {
            "enum": [
              "created",
              "updated",
              "deleted",
              "withdrawn"
            ]
          },
          "resource": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "before": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 16384
              },
              {
                "type": "object",
                "maxProperties": 64
              }
            ]
          },
          "after": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 16384
              },
              {
                "type": "object",
                "maxProperties": 64
              }
            ]
          },
          "source": {
            "type": "string",
            "maxLength": 128
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "changed_fields": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "context": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 16384
                },
                {
                  "type": "object",
                  "maxProperties": 64
                }
              ]
            }
          },
          "previously_relevant": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
